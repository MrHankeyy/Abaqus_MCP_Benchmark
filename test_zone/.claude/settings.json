{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "ToolSearch",
      "Skill",
      "mcp__abaqus-mcp"
    ],
    "deny": [
      "Bash",
      "PowerShell",
      "WebFetch",
      "WebSearch",
      "Agent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "python ../allowlist_gate.py" }
        ]
      }
    ]
  }
}
