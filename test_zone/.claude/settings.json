{
  "permissions": {
    "defaultMode": "default",
    "additionalDirectories": [],
    "allow": [
      "Read(./**)",
      "Edit(./**)",
      "Write(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "ToolSearch",
      "Skill",
      "mcp__abaqus-mcp"
    ],
    "deny": [
      "Read(../**)",
      "Edit(../**)",
      "Write(../**)",
      "Glob(../**)",
      "Grep(../**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python ../allowlist_gate.py"
          }
        ]
      }
    ]
  }
}
